# Kopieer dit bestand naar  .env  en vul je eigen waarden in.
# ⚠️ Deel .env NOOIT en zet het niet in git — het bevat je sleutel en wachtwoord-hash.

# Gratis account: https://twelvedata.com/
TWELVEDATA_API_KEY=

# Optioneel, alleen als je later nieuws/sentiment via Alpha Vantage toevoegt
ALPHAVANTAGE_API_KEY=

# Standaard SQLite (werkt meteen, geen installatie nodig).
# PostgreSQL: postgresql+psycopg2://gebruiker:wachtwoord@localhost:5432/snowy_tracks
DATABASE_URL=sqlite:///./snowy_tracks.db

# NOOIT het platte wachtwoord — dit is de bcrypt-hash ervan.
# Genereer met:  python -m app.tools.hash_password
APP_PASSWORD_HASH=

# Lange willekeurige string. Genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=verander-dit-in-een-lange-willekeurige-string
SESSION_TTL_MINUTES=30

# Symbolen die de achtergrond-scheduler live ververst
WATCHLIST=NVDA,AAPL,TSLA,ASML,MSFT,BTC/USD

# Pauze tussen ververs-rondes (gratis Twelve Data-tier heeft een krappe limiet)
REFRESH_INTERVAL_SECONDS=60
