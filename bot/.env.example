# Kopieer dit bestand naar  .env  en vul je sleutels in.
# Het .env-bestand wordt automatisch ingelezen door de bot.
# ⚠️ Deel .env NOOIT en zet het niet online — het bevat geheime sleutels.

# Voor de slimme nieuws-analyse via Claude (https://console.anthropic.com):
ANTHROPIC_API_KEY=sk-ant-vul-hier-je-sleutel-in

# Voor Telegram-meldingen (optioneel — laat leeg als je dit niet wilt):
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
